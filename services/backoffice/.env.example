BACKOFFICE_SECRET_KEY=replace-with-a-private-key
BACKOFFICE_DEBUG=True
BACKOFFICE_ALLOWED_HOSTS=localhost,127.0.0.1
BACKOFFICE_DB_NAME=backoffice
BACKOFFICE_DB_USER=backoffice
BACKOFFICE_DB_PASSWORD=replace-with-private-password
BACKOFFICE_DB_HOST=backoffice-postgres
BACKOFFICE_DB_PORT=5432
BACKOFFICE_GATEWAY_BASE_URL=http://gateway-api:8000
BACKOFFICE_GATEWAY_SERVICE_TOKEN=replace-with-shared-service-token
# Должен совпасть с BACKOFFICE_SERVICE_TOKEN в Journal, не с секретом Gateway.
BACKOFFICE_JOURNAL_BASE_URL=http://journal-api:8000
BACKOFFICE_JOURNAL_SERVICE_TOKEN=replace-with-journal-service-token
BACKOFFICE_CSRF_TRUSTED_ORIGINS=http://localhost:8080
BACKOFFICE_SECURE_COOKIES=False
BACKOFFICE_TRUST_PROXY=False
