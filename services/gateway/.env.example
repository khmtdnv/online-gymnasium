DATABASE_URL=postgresql+asyncpg://gateway:gateway@gateway-postgres:5432/gateway
JWT_SECRET=change-me
BACKOFFICE_SERVICE_TOKEN=change-me
JOURNAL_SERVICE_TOKEN=change-me-journal-to-gateway-only
# Отдельная обратная read-связь Gateway -> Journal.
JOURNAL_BASE_URL=http://journal-api:8000
JOURNAL_READ_SERVICE_TOKEN=replace-with-gateway-read-journal-token
# Принципал записи уроков (lesson-records:write); совпадает с
# GATEWAY_WRITE_SERVICE_TOKEN в Journal, не равен read-токену.
JOURNAL_WRITE_SERVICE_TOKEN=replace-with-gateway-write-journal-token
REFRESH_COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:8080
HOMEWORK_BASE_URL=http://homework-api:8000
HOMEWORK_SERVICE_TOKEN=replace-with-dedicated-gateway-to-homework-token
SCHEDULE_BASE_URL=http://schedule-api:8000
SCHEDULE_SERVICE_TOKEN=change-me-gateway-to-schedule-only
ANALYTICS_BASE_URL=http://analytics-api:8000
ANALYTICS_READ_SERVICE_TOKEN=replace-with-distinct-analytics-read-token
PEN_BASE_URL=http://pen-api:8000
PEN_SERVICE_TOKEN=replace-with-dedicated-gateway-pen-secret
BILLING_BASE_URL=http://billing-api:8000
BILLING_SERVICE_TOKEN=change-me-billing-gateway-pair
# Включать только после настройки тестовой ЮKassa и проверки оплаты учеников.
ENFORCE_TUITION_ACCESS=false
DOCUMENTS_BASE_URL=http://document-api:8000
DOCUMENTS_SERVICE_TOKEN=change-me-documents-gateway-pair
NOTIFICATIONS_BASE_URL=http://notifications-api:8000
NOTIFICATIONS_SERVICE_TOKEN=change-me-notifications-gateway-pair
