DATABASE_URL=postgresql+asyncpg://homework:change-me@homework-postgres:5432/homework
GATEWAY_SERVICE_TOKEN=replace-with-dedicated-gateway-to-homework-token
SCHEDULE_BASE_URL=http://schedule-api:8000
SCHEDULE_SERVICE_TOKEN=replace-with-dedicated-homework-token-in-schedule
JOURNAL_BASE_URL=http://journal-api:8000
JOURNAL_SERVICE_TOKEN=replace-with-dedicated-homework-token-in-journal
# Не root credentials. Пользователя создаёт homework-minio-init из .minio.env.
MINIO_ENDPOINT=homework-minio:9000
MINIO_ACCESS_KEY=homework-files
MINIO_SECRET_KEY=replace-with-homework-storage-password
MINIO_BUCKET=homework-files
MINIO_SECURE=false
