# Только MinIO и его one-shot init; root credentials не передавать Homework API.
MINIO_ROOT_USER=homework-root
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_ENDPOINT=http://homework-minio:9000
MINIO_BUCKET=homework-files
# Эти два значения должны совпадать с отдельными правами приложения в .env.
MINIO_ACCESS_KEY=homework-files
MINIO_SECRET_KEY=replace-with-homework-storage-password
# Незавершённые multipart-передачи убирает сам MinIO, не SQL cleanup-процесс.
MINIO_API_STALE_UPLOADS_EXPIRY=24h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=6h
