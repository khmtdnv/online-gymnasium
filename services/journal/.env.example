DATABASE_URL=postgresql+asyncpg://journal:change-me@journal-postgres:5432/journal
BACKOFFICE_SERVICE_TOKEN=change-me-journal-only
# Добавление учеников требует Gateway; чтения работают и без него.
GATEWAY_BASE_URL=http://gateway-api:8000
# Должен совпадать с JOURNAL_SERVICE_TOKEN в Gateway, не с BACKOFFICE_SERVICE_TOKEN.
GATEWAY_SERVICE_TOKEN=change-me-journal-to-gateway-only
# Отдельный входящий секрет Homework; не равен BACKOFFICE_SERVICE_TOKEN.
# Совпадает с JOURNAL_SERVICE_TOKEN в Homework.
HOMEWORK_SERVICE_TOKEN=change-me-homework-to-journal-only
# Чтения дневника и записей урока для Gateway (расширяет read-принципал).
GATEWAY_READ_SERVICE_TOKEN=replace-with-gateway-read-journal-token
# Отдельный входящий секрет записи уроков; не равен остальным.
# Совпадает с JOURNAL_WRITE_SERVICE_TOKEN в Gateway.
GATEWAY_WRITE_SERVICE_TOKEN=replace-with-gateway-write-journal-token
# Отдельный токен Billing: только чтение классов для выставления счетов.
BILLING_READ_SERVICE_TOKEN=replace-with-billing-read-journal-token
